
name: Build Windows EXE

on:
  push:
    branches: ["main"]
    tags: ["v*"]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    name: Build V20 Windows EXE
    runs-on: windows-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v5

      - name: Set up Python 3.13 x64
        uses: actions/setup-python@v6
        with:
          python-version: "3.13"
          architecture: x64
          cache: pip

      - name: Verify project files
        shell: pwsh
        run: |
          if (!(Test-Path "app.py")) { throw "app.py fehlt." }
          if (!(Test-Path "SchlauWutzie_V20_FINAL.spec")) { throw "SPEC fehlt." }
          if (!(Test-Path "assets\schlawutzie.png")) { throw "assets\schlawutzie.png fehlt." }
          Write-Host "Projektdateien OK."

      - name: Install dependencies
        shell: pwsh
        run: |
          python -m pip install --upgrade pip
          python -m pip install -r requirements.txt

      - name: Verify OneCore PyWinRT imports
        shell: pwsh
        run: |
          python -c "import winrt.windows.foundation; import winrt.windows.foundation.collections; import winrt.windows.media.speechsynthesis; import winrt.windows.storage; import winrt.windows.storage.streams; from winrt.windows.media.speechsynthesis import SpeechSynthesizer; from winrt.windows.storage.streams import DataReader; print('PyWinRT OK:', SpeechSynthesizer, DataReader)"

      - name: Verify asset dimensions
        shell: pwsh
        run: |
          python -c "from PIL import Image; im=Image.open('assets/schlawutzie.png'); print('Asset:', im.size, im.mode); assert im.width > 500 and im.height > 800"

      - name: Build one-file EXE
        shell: pwsh
        run: |
          Remove-Item -Recurse -Force -ErrorAction SilentlyContinue build, dist
          python -m PyInstaller --clean --noconfirm SchlauWutzie_V20_FINAL.spec
          $exe = "dist\SchlauWutzie_V20_FINAL.exe"
          if (!(Test-Path $exe)) { throw "EXE wurde nicht erzeugt." }
          $size = (Get-Item $exe).Length
          Write-Host "EXE size: $size bytes"
          if ($size -lt 1000000) { throw "EXE ist unerwartet klein." }

      - name: Upload EXE artifact
        uses: actions/upload-artifact@v4
        with:
          name: SchlauWutzie_V20_FINAL-Windows-x64
          path: dist/SchlauWutzie_V20_FINAL.exe
          if-no-files-found: error
          retention-days: 14

      - name: Create GitHub Release for version tags
        if: startsWith(github.ref, 'refs/tags/v')
        uses: softprops/action-gh-release@v2
        with:
          files: dist/SchlauWutzie_V20_FINAL.exe
          generate_release_notes: true
